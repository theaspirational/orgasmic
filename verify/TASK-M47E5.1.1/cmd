# One line. Run from the repo root by `orgasmic verify TASK-M47E5.1.1`.
#
# Single-threaded ordering makes the sibling-stem refusal the first panic in the
# pinned red. The two filters cover the widened finalize command/path pair and
# the missing-config fail-closed contract. The project dispatch read assertion
# lives before each finalize refusal, so the green also proves that grant stayed
# independent and unchanged.
env -u ORGASMIC_RUN_ID -u ORGASMIC_HOME cargo test -p orgasmic-drivers --lib -- --test-threads=1 --skip legacy_drivers_and_explicit_pairs_emit_equivalent_start_events a_finalize_grant_is_scoped_to_the_current_attempt_artifact_dir b_finalize_artifact_grant_refuses_when_no_artifact_dir_is_configured
