# Build an isolated PATH containing the host tmux, then poison inherited $TMUX
# with a non-socket. Under the injection the availability gate does not claim
# an owned `-L` server, so the manager launch reaches the poisoned endpoint.
T=$(mktemp -d); mkdir -p "$T/bin"; TMUX_BIN=$(command -v tmux || true); if [ -z "$TMUX_BIN" ]; then echo "TASK-2GS7V replay refused: tmux is not installed"; rm -rf "$T"; exit 2; fi; ln -sf "$TMUX_BIN" "$T/bin/tmux"; : > "$T/dead-socket"; env -u ORGASMIC_RUN_ID -u ORGASMIC_HOME -u ORGASMIC_TMUX_SOCKET PATH="$T/bin:$PATH" TMUX="$T/dead-socket,1,0" cargo test -p orgasmic-cli --test dispatch app_manager_release_via_cli_orgasmic_run_id; rc=$?; rm -rf "$T"; exit $rc
